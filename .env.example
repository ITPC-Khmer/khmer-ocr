# Khmer OCR configuration — copy to .env and adjust
# Local Ollama server used for OCR text correction
OLLAMA_URL=http://localhost:11434
# Correction model (must be pulled: ollama pull gemma2:9b)
OLLAMA_MODEL=gemma2:9b
# Set to 0 to disable LLM correction entirely
OLLAMA_CORRECT=1
# Only pages with Tesseract confidence below this get corrected
CORRECT_BELOW_CONFIDENCE=85

# PostgreSQL for job persistence
DATABASE_URL=postgresql:///khmer_ocr
