[Unit]
Description=Khmer OCR API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/khmer-ocr
Environment=OLLAMA_MODEL=gemma2:9b
ExecStart=/opt/khmer-ocr/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
